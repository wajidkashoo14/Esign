# --- Database -------------------------------------------------------------
# Local (SQLite, relative to the prisma/ folder):
DATABASE_URL="file:./dev.db"
# Postgres (Neon / Supabase) - used by `npm run vercel-build`:
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"   # non-pooled URL, for migrations

# --- Owner login ----------------------------------------------------------
OWNER_EMAIL="owner@example.com"
# Generate with: npm run hash-password -- "your password"
# NOTE: in .env files every "$" in the bcrypt hash must be written as "\$"
# (the script prints it that way). In Vercel's dashboard paste the raw hash.
OWNER_PASSWORD_HASH=""
# Random string, at least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# --- App ------------------------------------------------------------------
# Public base URL used in signing links (no trailing slash).
APP_URL="http://localhost:3000"

# --- Email (optional). With neither configured, links are shown in the UI ---
EMAIL_FROM="E-Sign <no-reply@example.com>"
# Option A: Resend
RESEND_API_KEY=""
# Option B: SMTP via nodemailer
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
